---
import AdminBlogManager from '../../components/AdminBlogManager';
import AdminRecommendationsManager from '../../components/AdminRecommendationsManager';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import LocalDate from '../../components/LocalDate.astro';
import MusicToggle from '../../components/MusicToggle';
import ThemeToggle from '../../components/ThemeToggle';
import { SITE_TITLE } from '../../consts';
import { getSession } from '../../lib/auth';

export const prerender = false;

const session = await getSession(Astro.request);
if (!session || !session.user.isAdmin) {
  return Astro.redirect('/login');
}

const user = session.user;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Admin Dashboard - ${SITE_TITLE}`}
      description="Website Administration Dashboard"
    />
    <script is:inline>
      (function () {
        const theme =
          (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) || 'light';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col justify-between bg-white font-sans text-[13px] leading-relaxed text-black transition-colors duration-150 dark:bg-[#151515] dark:text-[#e0e0e0]"
  >
    <div class="flex flex-1 flex-col">
      {/* Top Header */}
      <header
        class="border-b border-gray-200 bg-white px-4 py-3 dark:border-[#222222] dark:bg-[#151515]"
      >
        <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-2">
          <div class="flex items-center space-x-2">
            <a
              href="/"
              class="font-serif text-xl font-bold text-black hover:underline dark:text-white"
              >pacos</a
            >
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <span class="font-medium text-black dark:text-[#cccccc]">nyc</span>
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <span class="text-gray-600 dark:text-[#aaaaaa]">admin dashboard</span>
          </div>
          <div class="flex items-center space-x-3 text-xs">
            <LocalDate />
            <ThemeToggle client:load />
            <MusicToggle client:load />
          </div>
        </div>
      </header>

      {/* Main Content */}
      <main class="mx-auto flex w-full max-w-4xl flex-1 flex-col gap-6 px-4 py-8">
        {/* Admin Profile Banner */}
        <div
          class="flex flex-wrap items-center justify-between gap-4 rounded-xs border border-gray-200 bg-gray-50/50 p-4 dark:border-[#2a2a2a] dark:bg-[#1c1c1c]"
        >
          <div class="flex items-center gap-3">
            {
              user.avatarUrl && (
                <img
                  src={user.avatarUrl}
                  alt={user.username}
                  class="h-10 w-10 rounded-full border border-gray-300 dark:border-[#444444]"
                />
              )
            }
            <div>
              <div class="flex items-center gap-2 text-sm font-bold text-black dark:text-white">
                <span>{user.name}</span>
                <span
                  class="rounded-xs bg-green-100 px-1.5 py-0.5 text-[10px] font-semibold text-green-800 dark:bg-[#1a3820] dark:text-green-300"
                >
                  Authorized Admin
                </span>
              </div>
              <div class="font-mono text-xs text-gray-500 dark:text-gray-400">
                @{user.username}
              </div>
            </div>
          </div>

          <div>
            <a
              href="/api/auth/logout"
              class="rounded-xs border border-gray-300 bg-white px-3 py-1.5 text-xs transition-colors hover:bg-gray-100 dark:border-[#444444] dark:bg-[#252525] dark:hover:bg-[#333333]"
            >
              Sign Out
            </a>
          </div>
        </div>

        {/* 1. Blog Posts Manager */}
        <section
          class="rounded-xs border border-gray-200 bg-white p-4 dark:border-[#2a2a2a] dark:bg-[#1a1a1a]"
        >
          <div class="mb-3">
            <h2
              class="border-b border-gray-200 pb-1 text-xs font-bold tracking-wide text-black uppercase dark:border-[#2a2a2a] dark:text-white"
            >
              Blog / Writings Manager
            </h2>
            <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">
              Compose, edit, and publish blog posts to <a href="/blog" class="craigslist-link"
                >/blog</a
              >. Synced directly to your Google Sheet!
            </p>
          </div>
          <AdminBlogManager client:load />
        </section>

        {/* 2. Recommended Listening Management Component */}
        <section
          class="rounded-xs border border-gray-200 bg-white p-4 dark:border-[#2a2a2a] dark:bg-[#1a1a1a]"
        >
          <div class="mb-3">
            <h2
              class="border-b border-gray-200 pb-1 text-xs font-bold tracking-wide text-black uppercase dark:border-[#2a2a2a] dark:text-white"
            >
              Recommended Listening Manager
            </h2>
            <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">
              Add, manage, and delete songs, albums, and podcasts on <a
                href="/music/recommended"
                class="craigslist-link">/music/recommended</a
              >. Synced directly to your Google Sheet!
            </p>
          </div>
          <AdminRecommendationsManager client:load />
        </section>

        {/* Return Links */}
        <div class="flex gap-4 border-t border-gray-100 pt-6 text-xs dark:border-[#2a2a2a]">
          <a href="/" class="craigslist-link"> &larr; return to homepage </a>
          <span class="text-gray-400">&bull;</span>
          <a href="/music/recommended" class="craigslist-link"> view recommended listening </a>
        </div>
      </main>
    </div>

    {/* Footer */}
    <Footer />

    {/* Scoped CSS for Classic Craigslist Links */}
    <style is:global>
      a.craigslist-link,
      .craigslist-link a,
      a.craigslist-link:link {
        color: #0000ee;
        text-decoration: underline;
      }
      a.craigslist-link:visited {
        color: #551a8b;
      }
      a.craigslist-link:hover {
        text-decoration: underline;
        color: #0000ee;
      }
      a.craigslist-link:active {
        color: #ee0000;
      }
      .dark a.craigslist-link,
      .dark .craigslist-link a,
      .dark a.craigslist-link:link {
        color: #58a6ff;
        text-decoration: underline;
      }
      .dark a.craigslist-link:visited {
        color: #c084fc;
      }
      .dark a.craigslist-link:hover {
        text-decoration: underline;
        color: #79b8ff;
      }
      .dark a.craigslist-link:active {
        color: #ff7b72;
      }
    </style>
  </body>
</html>
