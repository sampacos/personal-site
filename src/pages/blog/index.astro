---
import AuthButton from '../../components/AuthButton';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import LocalDate from '../../components/LocalDate.astro';
import MusicToggle from '../../components/MusicToggle';
import ThemeToggle from '../../components/ThemeToggle';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getSession } from '../../lib/auth';
import { getBlogPosts } from '../../lib/sheets';

export const prerender = false;

const session = await getSession(Astro.request);
const isAdmin = !!(session && session.user.isAdmin);

const allPosts = await getBlogPosts();

// Pagination (10 posts per page)
const POSTS_PER_PAGE = 10;
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam || '1', 10) || 1);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const posts = allPosts.slice(startIndex, startIndex + POSTS_PER_PAGE);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog / Writings - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <script is:inline>
      (function () {
        const theme =
          (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) || 'light';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col justify-between bg-white font-sans text-[13px] leading-relaxed text-black transition-colors duration-150 dark:bg-[#151515] dark:text-[#e0e0e0]"
  >
    <div class="flex flex-1 flex-col">
      {/* Top Header Banner */}
      <header
        class="border-b border-gray-200 bg-white px-4 py-3 dark:border-[#222222] dark:bg-[#151515]"
      >
        <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-2">
          <div class="flex items-center space-x-2">
            <a
              href="/"
              class="font-serif text-xl font-bold text-black hover:underline dark:text-white"
              >pacos</a
            >
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <span class="font-medium text-black dark:text-[#cccccc]">nyc</span>
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <span class="text-gray-600 dark:text-[#aaaaaa]">blog / writings</span>
          </div>
          <div class="flex items-center space-x-3 text-xs">
            <LocalDate />
            <ThemeToggle client:load />
            <MusicToggle client:load />
            <AuthButton client:load />
          </div>
        </div>
      </header>

      {/* Main Content Area */}
      <main class="mx-auto flex w-full max-w-4xl flex-1 flex-col gap-6 px-4 py-8">
        <div
          class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 pb-3 dark:border-[#2a2a2a]"
        >
          <div>
            <h1 class="mb-1 font-serif text-base font-bold text-black dark:text-white">
              Writings &amp; Notes
            </h1>
            <p class="text-xs text-gray-600 dark:text-gray-400">
              Essays, updates, baking logs, and observations.
            </p>
          </div>

          {
            isAdmin && (
              <a
                href="/admin"
                class="inline-flex items-center gap-1 rounded-xs bg-black px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-200"
              >
                <span>+</span> Create New Post
              </a>
            )
          }
        </div>

        {/* Posts Listing */}
        <div class="space-y-6">
          {
            posts.length === 0 ? (
              <p class="py-8 text-center text-xs text-gray-500 italic dark:text-gray-400">
                No blog posts published yet.
              </p>
            ) : (
              <ul class="m-0 list-none space-y-6 p-0">
                {posts.map((post) => (
                  <li class="space-y-1.5 border-b border-gray-100 pb-6 last:border-b-0 dark:border-[#222222]">
                    <div class="flex flex-wrap items-baseline gap-2">
                      <a
                        href={`/blog/${post.slug}`}
                        class="craigslist-link font-serif text-sm font-bold"
                      >
                        {post.title}
                      </a>
                      <span class="text-[11px] text-gray-500 dark:text-gray-400">
                        {new Date(post.publishedAt).toLocaleDateString('en-US', {
                          month: 'short',
                          day: 'numeric',
                          year: 'numeric',
                        })}
                      </span>
                    </div>

                    {post.description && (
                      <p class="text-xs leading-normal text-gray-700 dark:text-gray-300">
                        {post.description}
                      </p>
                    )}

                    <div>
                      <a
                        href={`/blog/${post.slug}`}
                        class="craigslist-link text-[11px] font-medium"
                      >
                        read full post &rarr;
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        {/* Pagination Controls */}
        {
          totalPages > 1 && (
            <nav class="flex items-center justify-between border-t border-gray-200 pt-4 text-xs dark:border-[#2a2a2a]">
              <div>
                {currentPage > 1 ? (
                  <a href={`/blog?page=${currentPage - 1}`} class="craigslist-link">
                    &larr; previous page
                  </a>
                ) : (
                  <span class="text-gray-400 dark:text-gray-600">&larr; previous page</span>
                )}
              </div>

              <span class="text-gray-500 dark:text-gray-400">
                Page {currentPage} of {totalPages}
              </span>

              <div>
                {currentPage < totalPages ? (
                  <a href={`/blog?page=${currentPage + 1}`} class="craigslist-link">
                    next page &rarr;
                  </a>
                ) : (
                  <span class="text-gray-400 dark:text-gray-600">next page &rarr;</span>
                )}
              </div>
            </nav>
          )
        }

        {/* Return Links */}
        <div class="flex gap-4 border-t border-gray-100 pt-6 text-xs dark:border-[#2a2a2a]">
          <a href="/" class="craigslist-link"> &larr; return to homepage </a>
          <span class="text-gray-400">&bull;</span>
          <a href="/rss.xml" class="craigslist-link"> rss feed </a>
        </div>
      </main>
    </div>

    {/* Shared Footer */}
    <Footer />

    {/* Scoped CSS for Classic Craigslist Links */}
    <style is:global>
      a.craigslist-link,
      .craigslist-link a,
      a.craigslist-link:link {
        color: #0000ee;
        text-decoration: underline;
      }
      a.craigslist-link:visited {
        color: #551a8b;
      }
      a.craigslist-link:hover {
        text-decoration: underline;
        color: #0000ee;
      }
      a.craigslist-link:active {
        color: #ee0000;
      }
      .dark a.craigslist-link,
      .dark .craigslist-link a,
      .dark a.craigslist-link:link {
        color: #58a6ff;
        text-decoration: underline;
      }
      .dark a.craigslist-link:visited {
        color: #c084fc;
      }
      .dark a.craigslist-link:hover {
        text-decoration: underline;
        color: #79b8ff;
      }
      .dark a.craigslist-link:active {
        color: #ff7b72;
      }
    </style>
  </body>
</html>
