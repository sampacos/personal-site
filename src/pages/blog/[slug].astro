---
import { marked } from 'marked';
import AuthButton from '../../components/AuthButton';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import LocalDate from '../../components/LocalDate.astro';
import MusicToggle from '../../components/MusicToggle';
import ThemeToggle from '../../components/ThemeToggle';
import { SITE_TITLE } from '../../consts';
import { getSession } from '../../lib/auth';
import { getBlogPostBySlug } from '../../lib/sheets';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog');
}

const post = await getBlogPostBySlug(slug);
if (!post) {
  return new Response('Blog post not found', { status: 404 });
}

const session = await getSession(Astro.request);
const isAdmin = !!(session && session.user.isAdmin);

// Convert markdown to HTML
const htmlContent = marked.parse(post.content);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${post.title} - ${SITE_TITLE}`}
      description={post.description || post.title}
    />
    <script is:inline>
      (function () {
        const theme =
          (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) || 'light';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col justify-between bg-white font-sans text-[13px] leading-relaxed text-black transition-colors duration-150 dark:bg-[#151515] dark:text-[#e0e0e0]"
  >
    <div class="flex flex-1 flex-col">
      {/* Top Header Banner */}
      <header
        class="border-b border-gray-200 bg-white px-4 py-3 dark:border-[#222222] dark:bg-[#151515]"
      >
        <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-2">
          <div class="flex items-center space-x-2">
            <a
              href="/"
              class="font-serif text-xl font-bold text-black hover:underline dark:text-white"
              >pacos</a
            >
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <span class="font-medium text-black dark:text-[#cccccc]">nyc</span>
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <a href="/blog" class="font-medium text-black hover:underline dark:text-[#cccccc]"
              >blog</a
            >
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <span class="max-w-[180px] truncate text-gray-600 sm:max-w-none dark:text-[#aaaaaa]"
              >{post.title}</span
            >
          </div>
          <div class="flex items-center space-x-3 text-xs">
            <LocalDate />
            <ThemeToggle client:load />
            <MusicToggle client:load />
            <AuthButton client:load />
          </div>
        </div>
      </header>

      {/* Main Article Area */}
      <main class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-6 px-4 py-10">
        {/* Article Header */}
        <header class="space-y-2 border-b border-gray-200 pb-4 dark:border-[#2a2a2a]">
          <div class="flex items-center justify-between gap-4">
            <h1 class="font-serif text-2xl font-bold tracking-tight text-black dark:text-white">
              {post.title}
            </h1>
            {
              isAdmin && (
                <a href="/admin" class="craigslist-link shrink-0 text-xs">
                  manage in admin
                </a>
              )
            }
          </div>

          <div class="flex flex-wrap items-center gap-3 text-xs text-gray-500 dark:text-gray-400">
            <time datetime={post.publishedAt}>
              {
                new Date(post.publishedAt).toLocaleDateString('en-US', {
                  weekday: 'long',
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </time>
          </div>

          {
            post.description && (
              <p class="pt-1 text-sm text-gray-600 italic dark:text-gray-300">{post.description}</p>
            )
          }
        </header>

        {/* Article Markdown Body */}
        <article
          class="prose dark:prose-invert blog-content max-w-none text-[13px] leading-relaxed text-black dark:text-[#d0d0d0]"
          set:html={htmlContent}
        />

        {/* Return Links */}
        <div class="flex gap-4 border-t border-gray-100 pt-8 text-xs dark:border-[#2a2a2a]">
          <a href="/blog" class="craigslist-link"> &larr; return to all blog posts </a>
          <span class="text-gray-400">&bull;</span>
          <a href="/" class="craigslist-link"> return to homepage </a>
        </div>
      </main>
    </div>

    {/* Shared Footer */}
    <Footer />

    {/* Scoped CSS for Classic Craigslist Links and Clean Typography */}
    <style is:global>
      a.craigslist-link,
      .craigslist-link a,
      a.craigslist-link:link {
        color: #0000ee;
        text-decoration: underline;
      }
      a.craigslist-link:visited {
        color: #551a8b;
      }
      a.craigslist-link:hover {
        text-decoration: underline;
        color: #0000ee;
      }
      a.craigslist-link:active {
        color: #ee0000;
      }
      .dark a.craigslist-link,
      .dark .craigslist-link a,
      .dark a.craigslist-link:link {
        color: #58a6ff;
        text-decoration: underline;
      }
      .dark a.craigslist-link:visited {
        color: #c084fc;
      }
      .dark a.craigslist-link:hover {
        text-decoration: underline;
        color: #79b8ff;
      }
      .dark a.craigslist-link:active {
        color: #ff7b72;
      }

      /* Blog Content Typography */
      .blog-content p {
        margin-bottom: 1.25em;
      }
      .blog-content h1,
      .blog-content h2,
      .blog-content h3,
      .blog-content h4 {
        font-family: ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
        font-weight: 700;
        margin-top: 1.5em;
        margin-bottom: 0.5em;
        color: inherit;
      }
      .blog-content h1 {
        font-size: 1.5rem;
      }
      .blog-content h2 {
        font-size: 1.25rem;
      }
      .blog-content h3 {
        font-size: 1.1rem;
      }
      .blog-content ul,
      .blog-content ol {
        margin-bottom: 1.25em;
        padding-left: 1.5em;
      }
      .blog-content ul {
        list-style-type: disc;
      }
      .blog-content ol {
        list-style-type: decimal;
      }
      .blog-content li {
        margin-bottom: 0.25em;
      }
      .blog-content blockquote {
        border-left: 3px solid #ccc;
        padding-left: 1rem;
        margin: 1.25em 0;
        color: #666;
        font-style: italic;
      }
      .dark .blog-content blockquote {
        border-left-color: #444;
        color: #aaa;
      }
      .blog-content code {
        font-family: ui-monospace, monospace;
        font-size: 0.9em;
        background-color: #f4f4f4;
        padding: 0.15em 0.3em;
        border-radius: 2px;
      }
      .dark .blog-content code {
        background-color: #222;
      }
      .blog-content pre {
        background-color: #f6f8fa;
        padding: 1rem;
        border-radius: 4px;
        overflow-x: auto;
        margin-bottom: 1.25em;
      }
      .dark .blog-content pre {
        background-color: #1c1c1c;
      }
    </style>
  </body>
</html>
