---
import AuthButton from '../../components/AuthButton';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import MusicToggle from '../../components/MusicToggle';
import ThemeToggle from '../../components/ThemeToggle';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Reserve a loaf - ${SITE_TITLE}`}
      description="Reserve fresh artisanal sourdough bread"
    />
    <script is:inline>
      (function () {
        const theme =
          (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) || 'light';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col justify-between bg-white font-sans text-[13px] leading-relaxed text-black transition-colors duration-150 dark:bg-[#151515] dark:text-[#e0e0e0]"
  >
    {/* Top Header Banner */}
    <header
      class="border-b border-gray-200 bg-white px-4 py-2 dark:border-[#333333] dark:bg-[#1e1e1e]"
    >
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-2">
        <div class="flex items-center space-x-2">
          <a
            href="/"
            class="font-serif text-xl font-bold text-black hover:underline dark:text-white">pacos</a
          >
          <span class="text-gray-400 dark:text-gray-500">&gt;</span>
          <span class="font-medium text-black dark:text-[#cccccc]">bread</span>
          <span class="text-gray-400 dark:text-gray-500">&gt;</span>
          <span class="text-gray-600 dark:text-[#aaaaaa]">reserve a loaf</span>
        </div>
        <div class="flex items-center space-x-3 text-xs">
          <ThemeToggle client:load />
          <MusicToggle client:load />
          <AuthButton client:load />
        </div>
      </div>
    </header>

    {/* Main Content Area */}
    <main
      class="mx-auto flex w-full max-w-4xl flex-1 flex-col items-center justify-center px-4 py-12 text-center"
    >
      <div
        class="w-full max-w-lg rounded-xs border border-gray-200 bg-white p-8 shadow-sm dark:border-[#333333] dark:bg-[#1c1c1c]"
      >
        <div class="mb-3 text-3xl">🍞 ⏳</div>
        <h1 class="mb-2 font-serif text-xl font-bold text-black dark:text-[#f0f0f0]">
          Reserve a Loaf
        </h1>
        <div
          class="mb-4 inline-block rounded-xs border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-900 dark:border-[#5c4a16] dark:bg-[#3d3210] dark:text-[#ffe885]"
        >
          Development in progress
        </div>
        <p class="mb-6 text-xs text-gray-600 dark:text-[#aaaaaa]">
          The loaf reservation system is currently fermenting and under active construction. Check
          back soon to reserve fresh sourdough bakes.
        </p>
        <div class="border-t border-gray-100 pt-4 dark:border-[#333333]">
          <a href="/" class="craigslist-link text-xs font-semibold"> &larr; return to homepage </a>
        </div>
      </div>
    </main>

    {/* Footer */}
    <Footer />

    {/* Scoped CSS for Classic Craigslist Links */}
    <style is:global>
      a.craigslist-link,
      a.craigslist-link:link {
        color: #0000ee;
        text-decoration: underline;
      }
      a.craigslist-link:visited {
        color: #551a8b;
      }
      a.craigslist-link:hover {
        text-decoration: underline;
        color: #0000ee;
      }
      a.craigslist-link:active {
        color: #ee0000;
      }
      .dark a.craigslist-link,
      .dark a.craigslist-link:link {
        color: #58a6ff;
        text-decoration: underline;
      }
      .dark a.craigslist-link:visited {
        color: #c084fc;
      }
      .dark a.craigslist-link:hover {
        text-decoration: underline;
        color: #79b8ff;
      }
      .dark a.craigslist-link:active {
        color: #ff7b72;
      }
    </style>
  </body>
</html>
