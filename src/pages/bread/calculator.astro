---
import BreadCalculator from '../../components/BreadCalculator';
import BakesTable from '../../components/BakesTable.astro';
import AuthButton from '../../components/AuthButton';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import MusicToggle from '../../components/MusicToggle';
import ThemeToggle from '../../components/ThemeToggle';
import { SITE_TITLE } from '../../consts';
import { getSession } from '../../lib/auth';
import { getBakes } from '../../lib/bakes';

export const prerender = false;

const session = await getSession(Astro.request);
const isAdmin = !!(session && session.user.isAdmin);
const bakes = isAdmin ? await getBakes() : [];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Bread Calculator - ${SITE_TITLE}`}
      description="Bakers percentages and sourdough hydration calculator"
    />
    <script is:inline>
      (function () {
        const theme =
          (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) || 'light';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col justify-between bg-white font-sans text-[13px] leading-relaxed text-black transition-colors duration-150 dark:bg-[#151515] dark:text-[#e0e0e0]"
  >
    {/* Top Header Banner */}
    <header
      class="border-b border-gray-200 bg-white px-4 py-2 dark:border-[#333333] dark:bg-[#1e1e1e]"
    >
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-2">
        <div class="flex items-center space-x-2">
          <a
            href="/"
            class="font-serif text-xl font-bold text-black hover:underline dark:text-white">pacos</a
          >
          <span class="text-gray-400 dark:text-gray-500">></span>
          <span class="font-medium text-black dark:text-[#cccccc]">bread</span>
          <span class="text-gray-400 dark:text-gray-500">></span>
          <span class="text-gray-600 dark:text-[#aaaaaa]">bread calculator</span>
        </div>
        <div class="flex items-center space-x-3 text-xs">
          <ThemeToggle client:load />
          <MusicToggle client:load />
          <AuthButton client:load />
        </div>
      </div>
    </header>

    {/* Main Content Area */}
    <main class="mx-auto flex w-full max-w-4xl flex-1 flex-col items-center gap-6 px-4 py-8">
      <h1 class="font-serif text-xl font-bold text-black dark:text-[#f0f0f0]">Bread Calculator</h1>
      <BreadCalculator client:load isAdmin={isAdmin} />

      {
        isAdmin && (
          <section class="w-full max-w-2xl rounded-xs border border-gray-200 bg-white p-4 text-left shadow-sm dark:border-[#333333] dark:bg-[#1c1c1c]">
            <div class="mb-2 flex items-center justify-between gap-2">
              <h2 class="font-serif text-sm font-bold text-black dark:text-[#f0f0f0]">Bakes</h2>
              <a href="/bread/bakes" class="craigslist-link text-xs">
                all bakes &rarr;
              </a>
            </div>
            <BakesTable bakes={bakes} />
          </section>
        )
      }
    </main>

    {/* Footer */}
    <Footer />

    {/* Scoped CSS for Classic Craigslist Links */}
    <style is:global>
      a.craigslist-link,
      a.craigslist-link:link {
        color: #0000ee;
        text-decoration: underline;
      }
      a.craigslist-link:visited {
        color: #551a8b;
      }
      a.craigslist-link:hover {
        text-decoration: underline;
        color: #0000ee;
      }
      a.craigslist-link:active {
        color: #ff0000;
      }
    </style>
  </body>
</html>
