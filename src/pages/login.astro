---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import MusicToggle from '../components/MusicToggle';
import ThemeToggle from '../components/ThemeToggle';
import { SITE_TITLE } from '../consts';
import { getGitHubClientId, getSession } from '../lib/auth';

export const prerender = false;

const session = await getSession(Astro.request);
if (session && session.user.isAdmin) {
  return Astro.redirect('/admin');
}

const error = Astro.url.searchParams.get('error');
const isConfigured = !!getGitHubClientId();
const now = new Date();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Sign In - ${SITE_TITLE}`} description="Admin authentication" />
    <script is:inline>
      (function () {
        const theme =
          (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) || 'light';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col justify-between bg-white font-sans text-[13px] leading-relaxed text-black transition-colors duration-150 dark:bg-[#151515] dark:text-[#e0e0e0]"
  >
    <div class="flex flex-1 flex-col">
      {/* Header */}
      <header
        class="border-b border-gray-200 bg-white px-4 py-3 dark:border-[#222222] dark:bg-[#151515]"
      >
        <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-2">
          <div class="flex items-center space-x-2">
            <a
              href="/"
              class="font-serif text-xl font-bold text-black hover:underline dark:text-white"
              >pacos</a
            >
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <span class="font-medium text-black dark:text-[#cccccc]">nyc</span>
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <span class="text-gray-600 dark:text-[#aaaaaa]">account sign in</span>
          </div>
          <div class="flex items-center space-x-3 text-xs">
            <span class="text-gray-600 dark:text-gray-400">
              {
                now.toLocaleDateString('en-US', {
                  weekday: 'short',
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })
              }
            </span>
            <ThemeToggle client:load />
            <MusicToggle client:load />
          </div>
        </div>
      </header>

      {/* Main Content */}
      <main class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-4 py-16">
        <div
          class="rounded-xs border border-gray-200 bg-white p-6 shadow-xs dark:border-[#333333] dark:bg-[#1a1a1a]"
        >
          <h1 class="mb-2 font-serif text-base font-bold text-black dark:text-white">
            Admin Sign In
          </h1>
          <p class="mb-6 text-xs text-gray-600 dark:text-gray-400">
            Sign in with your authorized GitHub account to manage recommendations, site content, and
            blog posts.
          </p>

          {
            error && (
              <div class="mb-4 rounded-xs border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700 dark:border-[#5a2020] dark:bg-[#351515] dark:text-red-300">
                <span class="font-bold">Authentication error:</span>{' '}
                {error.startsWith('unauthorized_user')
                  ? 'This GitHub account is not authorized as an admin.'
                  : error}
              </div>
            )
          }

          {
            !isConfigured && (
              <div class="mb-4 rounded-xs border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-[#5c4a16] dark:bg-[#352c10] dark:text-[#ffd666]">
                <span class="font-bold">Setup Required:</span>{' '}
                <code class="font-mono text-[11px]">GITHUB_CLIENT_ID</code> and{' '}
                <code class="font-mono text-[11px]">GITHUB_CLIENT_SECRET</code> need to be set in
                your <code class="font-mono text-[11px]">.env</code> file.
              </div>
            )
          }

          <div class="pt-2">
            <a
              href="/api/auth/github/login"
              class="flex w-full items-center justify-center gap-2 rounded-xs bg-black px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-200"
            >
              <svg
                viewBox="0 0 16 16"
                width="16"
                height="16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                ></path>
              </svg>
              Continue with GitHub
            </a>
          </div>

          <div class="mt-6 border-t border-gray-100 pt-4 text-center text-xs dark:border-[#2a2a2a]">
            <a href="/" class="craigslist-link"> &larr; return to homepage </a>
          </div>
        </div>
      </main>
    </div>

    {/* Footer */}
    <Footer />

    {/* Scoped CSS for Classic Craigslist Links */}
    <style is:global>
      a.craigslist-link,
      .craigslist-link a,
      a.craigslist-link:link {
        color: #0000ee;
        text-decoration: underline;
      }
      a.craigslist-link:visited {
        color: #551a8b;
      }
      a.craigslist-link:hover {
        text-decoration: underline;
        color: #0000ee;
      }
      a.craigslist-link:active {
        color: #ee0000;
      }
      .dark a.craigslist-link,
      .dark .craigslist-link a,
      .dark a.craigslist-link:link {
        color: #58a6ff;
        text-decoration: underline;
      }
      .dark a.craigslist-link:visited {
        color: #c084fc;
      }
      .dark a.craigslist-link:hover {
        text-decoration: underline;
        color: #79b8ff;
      }
      .dark a.craigslist-link:active {
        color: #ff7b72;
      }
    </style>
  </body>
</html>
