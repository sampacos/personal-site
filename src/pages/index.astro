---
import AuthButton from '../components/AuthButton';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import LocalDate from '../components/LocalDate.astro';
import MusicToggle from '../components/MusicToggle';
import ThemeToggle from '../components/ThemeToggle';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getBlogPosts } from '../lib/sheets';

export const prerender = false;

const blogPosts = await getBlogPosts();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script is:inline>
      (function () {
        const theme =
          (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) || 'light';
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col justify-between bg-white font-sans text-[13px] leading-relaxed text-black transition-colors duration-150 dark:bg-[#151515] dark:text-[#e0e0e0]"
  >
    {/* Top Section Wrapper: Header + Main */}
    <div class="flex flex-1 flex-col">
      {/* Top Header Banner */}
      <header
        class="border-b border-gray-200 bg-white px-4 py-3 dark:border-[#222222] dark:bg-[#151515]"
      >
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2">
          <div class="flex items-center space-x-2">
            <span class="font-serif text-xl font-bold text-black dark:text-white">pacos</span>
            <span class="text-gray-400 dark:text-gray-600">&gt;</span>
            <span class="font-medium text-black dark:text-[#cccccc]">nyc</span>
          </div>
          <div class="flex items-center space-x-3 text-xs">
            <LocalDate />
            <ThemeToggle client:load />
            <MusicToggle client:load />
            <AuthButton client:load />
          </div>
        </div>
      </header>

      {/* Main Container: Sidebar + Content */}
      <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-8 px-4 py-6 md:flex-row">
        {/* Left Side Menu */}
        <aside class="flex w-full shrink-0 flex-col gap-6 md:w-52">
          {/* Brand Logo */}
          <div class="flex flex-col items-start gap-0.5 text-left">
            <a
              href="/"
              class="font-serif text-2xl font-black tracking-tight text-[#0000ee] hover:underline dark:text-[#58a6ff]"
            >
              ☮ pacos.nyc
            </a>
            <div class="text-[11px] text-gray-600 dark:text-gray-400">
              personal website &amp; archive
            </div>
          </div>

          {/* Quick Search */}
          <div>
            <label
              for="cl-search"
              class="mb-1 block text-xs font-bold text-black dark:text-gray-200"
            >
              search pacos.nyc
            </label>
            <form action="/blog" method="get" class="flex gap-1">
              <input
                type="search"
                id="cl-search"
                name="q"
                placeholder="search notes..."
                class="w-full rounded-xs border border-gray-300 bg-white px-2 py-1 text-xs text-black focus:outline-blue-500 dark:border-[#444444] dark:bg-[#252525] dark:text-[#f0f0f0]"
              />
              <button
                type="submit"
                class="cursor-pointer rounded-xs border border-gray-300 bg-white px-2.5 py-1 text-xs font-bold text-black hover:bg-gray-50 dark:border-[#555555] dark:bg-[#333333] dark:text-gray-200 dark:hover:bg-[#444444]"
              >
                &gt;
              </button>
            </form>
          </div>

          {/* Sidemenu Links */}
          <nav aria-label="Quick Links">
            <div
              class="mb-2 border-b border-gray-200 pb-1 text-xs font-bold tracking-wider text-black uppercase dark:border-[#2a2a2a] dark:text-white"
            >
              navigation
            </div>
            <ul class="m-0 list-none space-y-1 p-0">
              <li><a href="/" class="craigslist-link font-medium">home</a></li>
              <li><a href="/about" class="craigslist-link">about / bio</a></li>
              <li><a href="/blog" class="craigslist-link">blog / writings</a></li>
              <li><a href="/music" class="craigslist-link">music / listening</a></li>
              <li><a href="mailto:sam@pacos.nyc" class="craigslist-link">contact / email</a></li>
              <li>
                <a
                  href="https://github.com/sampacos"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="craigslist-link">github ↗</a
                >
              </li>
            </ul>
          </nav>

          {/* System Info */}
          <div
            class="space-y-0.5 border-t border-gray-200 pt-2 text-[11px] text-gray-600 dark:border-[#2a2a2a] dark:text-gray-400"
          >
            <strong>status: </strong>
            <a
              href="https://youtu.be/Q7Vbn6GbsWE?si=CROKNMBo_RidQWMm&t=405"
              target="_blank"
              rel="noopener noreferrer"
              class="craigslist-link">champions</a
            >
          </div>
        </aside>

        {/* Main Content Area (Craigslist Multi-Column Categories) */}
        <main class="min-w-0 flex-1">
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {/* 1. Photography */}
            <section class="bg-white dark:bg-transparent">
              <h2
                class="m-0 border-b border-gray-200 pb-1 text-xs font-bold tracking-wide text-black uppercase dark:border-[#2a2a2a] dark:text-white"
              >
                photography
              </h2>
              <div class="pt-2">
                <ul class="m-0 list-none space-y-1 p-0">
                  <li>
                    <a
                      href="/photos/2026"
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="craigslist-link">2026</a
                    >
                  </li>
                  <li>
                    <a
                      href="/photos/2025"
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="craigslist-link">2025</a
                    >
                  </li>
                  <li>
                    <a
                      href="/photos/2024"
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="craigslist-link">2024</a
                    >
                  </li>
                  <li>
                    <a
                      href="/photos/europe-2023"
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="craigslist-link">Europe Trip 2023</a
                    >
                  </li>
                  <li>
                    <a
                      href="/photos/all"
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="craigslist-link font-medium">All</a
                    >
                  </li>
                </ul>
              </div>
            </section>

            {/* 2. Bread Section */}
            <section class="bg-white dark:bg-transparent">
              <h2
                class="m-0 border-b border-gray-200 pb-1 text-xs font-bold tracking-wide text-black uppercase dark:border-[#2a2a2a] dark:text-white"
              >
                Bread, etc.
              </h2>
              <div class="pt-2">
                <ul class="m-0 list-none space-y-1 p-0">
                  <li>
                    <a href="/bread/reserve" class="craigslist-link"> reserve a loaf </a>
                  </li>
                  <li>
                    <a href="/bread/calculator" class="craigslist-link"> bread calculator </a>
                  </li>
                </ul>
              </div>
            </section>

            {/* 3. Blog / Writings */}
            <section class="bg-white dark:bg-transparent">
              <h2
                class="m-0 border-b border-gray-200 pb-1 text-xs font-bold tracking-wide text-black uppercase dark:border-[#2a2a2a] dark:text-white"
              >
                blog / writings
              </h2>
              <div class="pt-2">
                <ul class="m-0 list-none space-y-1.5 p-0">
                  {
                    blogPosts.slice(0, 4).map((post) => (
                      <li>
                        <a href={`/blog/${post.slug}`} class="craigslist-link">
                          {post.title.toLowerCase()}
                        </a>
                        <span class="block text-[10px] text-gray-500 dark:text-gray-400">
                          {new Date(post.publishedAt).toLocaleDateString('en-US', {
                            month: 'short',
                            day: 'numeric',
                          })}
                        </span>
                      </li>
                    ))
                  }
                  <li class="pt-1">
                    <a href="/blog" class="craigslist-link font-medium">
                      all blog posts ({blogPosts.length}) &rarr;
                    </a>
                  </li>
                </ul>
              </div>
            </section>

            {/* 4. Projects / Code */}
            <section class="bg-white dark:bg-transparent">
              <h2
                class="m-0 border-b border-gray-200 pb-1 text-xs font-bold tracking-wide text-black uppercase dark:border-[#2a2a2a] dark:text-white"
              >
                projects / code
              </h2>
              <div class="pt-2">
                <ul class="m-0 list-none space-y-1 p-0">
                  <li>
                    <a
                      href="https://github.com/sampacos"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="craigslist-link">github</a
                    >
                  </li>
                  <li>
                    <span class="text-[11px] text-gray-500 italic dark:text-gray-400"
                      >more on the way...</span
                    >
                  </li>
                </ul>
              </div>
            </section>

            {/* 5. Music / Listening */}
            <section class="bg-white dark:bg-transparent">
              <h2
                class="m-0 border-b border-gray-200 pb-1 text-xs font-bold tracking-wide text-black uppercase dark:border-[#2a2a2a] dark:text-white"
              >
                music / listening
              </h2>
              <div class="pt-2">
                <ul class="m-0 list-none space-y-1 p-0">
                  <li><a href="/music" class="craigslist-link">what i've been listening to</a></li>
                  <li>
                    <a
                      href="https://soundcloud.com/sam2445"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="craigslist-link">soundcloud profile</a
                    >
                  </li>
                  <li>
                    <a href="/music/recommended" class="craigslist-link">recommended listening</a>
                  </li>
                </ul>
              </div>
            </section>
          </div>
        </main>
      </div>
    </div>

    {/* Craigslist Styled Footer */}
    <Footer />

    {/* Scoped CSS for Classic Craigslist Links (Blue -> Visited Purple) and Layout */}
    <style is:global>
      /* Classic Craigslist Link Styles */
      a.craigslist-link,
      .craigslist-link a,
      a.craigslist-link:link {
        color: #0000ee;
        text-decoration: underline;
      }
      a.craigslist-link:visited {
        color: #551a8b;
      }
      a.craigslist-link:hover {
        text-decoration: underline;
        color: #0000ee;
      }
      a.craigslist-link:active {
        color: #ee0000;
      }

      /* Dark Mode Link Adaptations */
      .dark a.craigslist-link,
      .dark .craigslist-link a,
      .dark a.craigslist-link:link {
        color: #58a6ff;
        text-decoration: underline;
      }
      .dark a.craigslist-link:visited {
        color: #c084fc;
      }
      .dark a.craigslist-link:hover {
        text-decoration: underline;
        color: #79b8ff;
      }
      .dark a.craigslist-link:active {
        color: #ff7b72;
      }
    </style>
  </body>
</html>
